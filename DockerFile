# Build Stage
FROM node:22-alpine AS build
WORKDIR /app

# Enable corepack for pnpm support
RUN corepack enable

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci

# Copy prisma schema first for better caching
COPY prisma ./prisma
COPY prisma.config.ts ./

# Generate Prisma client with a dummy DATABASE_URL for build time
# The real DATABASE_URL will be provided at runtime
ENV DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy?schema=public"
RUN npx prisma generate

# Copy the entire project
COPY . ./

# Build the Nuxt application
RUN npm run build

# Production Stage
FROM node:22-alpine
WORKDIR /app

# Install necessary tools for healthcheck and database connection testing
RUN apk add --no-cache curl postgresql-client npm

# Copy built application from build stage
# The .output folder contains everything needed to run the app
COPY --from=build /app/.output ./

# Copy Prisma-related files for running migrations at startup
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/prisma.config.ts ./
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules

# Create a startup script
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# Environment variables (these should be overridden at runtime)
ENV PORT=3000
ENV HOST=0.0.0.0
ENV NODE_ENV=production

EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:3000/ || exit 1

ENTRYPOINT ["/app/docker-entrypoint.sh"]
